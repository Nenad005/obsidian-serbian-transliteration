{
  "name": "obsidian-serbian-transliteration",
  "version": "1.0.0",
  "private": true,
  "description": "Safe, local Serbian Cyrillic and Latin transliteration for Obsidian.",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run typecheck && node esbuild.config.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-frontmatter": "^2.0.1",
    "micromark-extension-frontmatter": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  }
}
