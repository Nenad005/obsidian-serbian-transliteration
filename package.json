{
  "name": "obsidian-serbian-transliteration",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Nenad005",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nenad005/obsidian-serbian-transliteration.git"
  },
  "bugs": {
    "url": "https://github.com/Nenad005/obsidian-serbian-transliteration/issues"
  },
  "engines": { "node": ">=22.12.0" },
  "description": "Safe, local Serbian Cyrillic and Latin transliteration for Obsidian.",
  "scripts": {
    "dev": "npm run notices && node esbuild.config.mjs --watch",
    "build": "npm run typecheck && npm run notices && node esbuild.config.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src package.json --max-warnings=0",
    "notices": "node scripts/generate-notices.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "check": "npm run lint && npm test && npm run build && npm run validate:release"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-frontmatter": "^2.0.1",
    "micromark-extension-frontmatter": "^2.0.0"
  },
  "overrides": {
    "moment": "^2.31.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
